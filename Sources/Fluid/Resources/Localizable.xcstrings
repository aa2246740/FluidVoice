          }
        }
      }
    },
    "This will permanently delete all %@ transcription entries. This action cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久删除全部 %@ 条转写记录，无法撤销。"
