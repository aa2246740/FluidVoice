            "state": "translated",
            "value": "将删除这个词已保存的修正和发音。"
          }
        }
      }
    },
    "This replaces the start word, formatting action phrases and enabled states, and every punctuation rule with their defaults.": {
      "localizations": {
        "zh-Hans": {
